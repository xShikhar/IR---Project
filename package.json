{
  "name": "turntrace",
  "version": "2.0.0",
  "description": "TurnTrace: Inspectable Conversational Search Engine built on core IR principles",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client",
    "eval"
  ],
  "scripts": {
    "prepare:data": "node server/scripts/prepareCorpus.js",
    "build:index": "node server/scripts/buildIndex.js",
    "pool:data": "node server/scripts/generatePoolingSheet.js",
    "test": "npm run test --workspace=server && npm run test --workspace=eval",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev": "node scripts/dev.js",
    "verify:data": "node scripts/verifyFrozenData.js",
    "unpack:data": "node scripts/verifyFrozenData.js --unpack",
    "eval": "node eval/src/index.js",
    "eval:v3": "node eval/src/v3.js",
    "eval:review": "node eval/src/v3Review.js",
    "prepare:semantic": "node server/scripts/prepareSemantic.js",
    "prepare:reranker": "node server/src/v3/reranker.js",
    "build": "npm run build --workspace=client",
    "start": "node server/src/api/server.js",
    "package:submission": "node scripts/packageSubmission.js",
    "test:browser": "playwright test",
    "report": "python scripts/renderReport.py"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "keywords": [
    "information-retrieval",
    "conversational-search",
    "vector-space-model",
    "bm25",
    "inverted-index"
  ],
  "author": "TurnTrace Team",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
